# Streamlit Cloud secrets example
# Copy these keys into Streamlit Cloud -> App -> Settings -> Secrets

GOOGLE_GEMINI_KEY = "paste_your_gemini_key"
ADMIN_PASSWORD = "change_this_password"

# For production URL in Streamlit Cloud, e.g. https://your-app.streamlit.app
REDIRECT_URI = "https://your-app.streamlit.app"

# Disable server-side pickle token files in cloud (ephemeral filesystem)
ENABLE_TOKEN_PERSISTENCE = "false"

# Option A (recommended): full OAuth client JSON as one string
# Escape inner quotes if you paste as a single-line JSON string
# GOOGLE_OAUTH_CLIENT_SECRET_JSON = "{\"web\":{...}}"

# Option B: provide id and secret separately
GOOGLE_OAUTH_CLIENT_ID = "your_google_oauth_client_id"
GOOGLE_OAUTH_CLIENT_SECRET = "your_google_oauth_client_secret"
